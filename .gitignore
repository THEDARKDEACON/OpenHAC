**/easyeda_generated.pretty/
**/easyeda_generated.3dshapes/
**/*.step
**/*.wrl
# KiCad CLI schematic ERC (SCH-003) and default *.rpt naming
*.kicad_sch.erc.txt
*-erc.rpt
*.kicad_sch.erc.json
# KiCad CLI PCB DRC reports (fabrication gate)
*.kicad_pcb.drc.txt
*.kicad_prl
# KiCad / editor lock files (e.g. ~project.kicad_pcb.lck)
*.lck
*.erc
_autosave-*
fp-info-cache
# Local KiCad library tables (project/user config; do not commit)
fp-lib-table
sym-lib-table
# IPC-2581 (kicad-cli pcb export ipc2581, MFG-001)
*.ipc2581
# KiCad 6+ project backups folder (if created locally)
*-backups/
*-backups-*/
# Optional local convention: custom DB path or scratch (see README / OPENHAC_DB_PATH)
.openhac/
openhac_local.db
# OpenHaC compile --zip-release default naming
*-release.zip
# Fab export / other build zips (when writing into repo tree)
*.zip

