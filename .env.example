# Copy to `.env` in the repo root (gitignored). Loaded automatically by `openhac` CLI.
# See `openhac database vendor_apis` docstring in `openhac/database/vendor_apis.py` for API registration.

# --- Autorouting (FreeRouting JAR) ---
# FREEROUTING_JAR=/path/to/freerouting-2.x.jar
# Show the FreeRouting Java window (default is headless). Same as: openhac compile --freerouting-gui
# OPENHAC_FREEROUTING_GUI=0
# Wall-clock cap on the Java process (default 1800s when unset / headless).
# GUI mode defaults to no timeout so the window is not killed after 30 min.
# OPENHAC_FREEROUTING_TIMEOUT_S=1800
# Cap passes so headless FreeRouting writes SES and exits.
# v2.1 CLI -mp only sets maxPasses; the maze loop reads stop_pass_no (default 999).
# OpenHaC sets FREEROUTING__ROUTER__STOP_PASS_NO to this value.
# OPENHAC_FREEROUTING_MAX_PASSES=12
# OPENHAC_FREEROUTING_MAX_THREADS=4
# OPENHAC_FREEROUTING_XMX=8g
# Skip the post-route optimizer (default on) so SES is written after the maze passes.
# OPENHAC_FREEROUTING_DISABLE_OPTIMIZER=1
# Stop Java if unrouted count does not improve for N pass logs (0=off, default).
# Plateau SIGINT on 2.1 discards copper — prefer STOP_PASS_NO over killing Java.
# OPENHAC_FREEROUTING_PLATEAU_PASSES=0
# After plateau SIGINT, wait this long for FreeRouting to flush -do SES.
# OPENHAC_FREEROUTING_SES_WAIT_S=20
# Optional grid maze after FreeRouting. Off by default — not a PCB router.
# OPENHAC_ASTAR_LEFTOVER=0
# OPENHAC_ASTAR_WINDOW_MM=25
# OPENHAC_ASTAR_MAX_PATHS=1500
# Argv template (JSON list or tokens with {dsn}/{ses}). Never a bash -c wrapper.
# OPENHAC_FREEROUTING_CMD=["java","-jar","/path/to/freerouting.jar","--gui.enabled=false","-de","{dsn}","-do","{ses}"]
# Progress while FreeRouting runs (default heartbeat 15s; stream child lines at info).
# OPENHAC_FREEROUTING_HEARTBEAT_S=15
# OPENHAC_FREEROUTING_STREAM_LOG=info
# Keep schematic under ``--production`` (otherwise sch is skipped by default).
# OPENHAC_PRODUCTION_SCHEMATIC=1

# --- Placement architecture ---
# Floorplan packs modules from the signal-net graph (shared nets sit adjacent).
# OPENHAC_PLACEMENT_ENGINE=affinity
# OPENHAC_PLACEMENT_ENGINE=z3
# OPENHAC_PLACEMENT_PACK=graph
# OPENHAC_PLACEMENT_PACK=shelf
# OPENHAC_CLUSTER_AFFINITY=1
# OPENHAC_PLACEMENT_MERGE_CLUSTERS=1
# OPENHAC_CLUSTER_GAP_MM=2
# OPENHAC_Z3_LEAF_ONLY=1
# OPENHAC_Z3_TIMEOUT_MS=60000
# OPENHAC_LAYOUT_ENLARGE_ON_UNSAT=1
# OPENHAC_LAYOUT_HARD_FAIL_UNSAT=  (default: on for fabrication goal)
# OPENHAC_REPAIR_EXPAND_BOARD_MAX_MM=40

# --- Schematic sheets (SCH-002) ---
# Flat by default until part count ≥ MIN_PARTS (25). Force multi/single with these:
# OPENHAC_SCHEMATIC_MULTI_SHEET=1
# OPENHAC_SCHEMATIC_SINGLE_SHEET=1
# OPENHAC_SCHEMATIC_MULTI_SHEET_MIN_PARTS=25

# --- Part enrichment (at least one set for online pinout / vendor metadata) ---
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# Use sandbox app credentials against Digi-Key sandbox host (401 often = prod/sandbox mismatch):
# DIGIKEY_USE_SANDBOX=1
# Or set full base URL: DIGIKEY_API_BASE=https://sandbox-api.digikey.com
# MOUSER_API_KEY=
# TME: portal "Token" → TME_API_TOKEN; "Application secret" → TME_API_SECRET (not customer number).
# If you get HTTP 403, check the developer portal: declared "purpose" must match API use (e.g. catalog vs order-only).
# TME_API_TOKEN=
# TME_API_SECRET=
# JLC: LCSC SKU lookup uses POST jlcpcb.com/.../selectSmtComponentList/v2 (no key) first; optional legacy GET + jlcsearch.
# Partner portal docs live at https://api.jlcpcb.com/ (App ID + Access Key) — different stack, not used here yet.
# JLCPCB_SMT_SEARCH_URL=
# JLCPCB_DISABLE_SMT=1
# JLCPCB_DISABLE_JLCSEARCH=1
# JLCPCB_API_KEY=
# Pinout merge: auto (default) merges KiCad ``kicad_symbol`` pins with vendor data; kicad_symbol prefers the library;
# vendor prefers distributors only.
# OPENHAC_ENRICH_PINOUT_PREFERENCE=auto

# --- Optional overrides ---
# OPENHAC_DB_PATH=/path/to/custom.db
# OPENHAC_NO_NETWORK=1

# --- Placement density (tune here — trial & error) ---
# These are the main dials for sparse vs packed boards. Copy to `.env` and edit;
# ``openhac compile`` loads them automatically (no need to export in the shell).
#
# Denser (tighter) ←————————————————————————————→ Roomier (easier Z3 / fewer overlaps)
#   PACK_INFLATE ≈ 1.15–1.35                     ≈ 1.8–2.4
#   MODULE_CLEARANCE_MM ≈ 2–4                    ≈ 8–12
#   PLACEMENT_FP_GAP_MM ≈ 1–2.5                  ≈ 4–6
#   AUTO_BOARD_MARGIN_FACTOR ≈ 1.25–1.4          ≈ 2.0–2.4
#
# If placement fails (Z3 UNSAT / footprint overlaps), nudge roomier by ~10–20%.
# If the board looks empty, nudge denser — do NOT rely on --deoverlap-iters for density.
#
# OPENHAC_MODULE_PACK_INFLATE=1.25
# OPENHAC_MODULE_CLEARANCE_MM=4
# (CLI ``--module-gap-mm`` overrides this when passed; omit the flag to use .env.)
# Placement/density OPENHAC_* keys in `.env` override stale shell exports.
# OPENHAC_PLACEMENT_FP_GAP_MM=2
# OPENHAC_AUTO_BOARD_MARGIN_FACTOR=1.35
# OPENHAC_AUTO_BOARD_MIN_EDGE_MARGIN_MM=6.0
#
# Initial SKiDL grid uses footprint bbox sizes when pcbnew can load libs (default on).
# OPENHAC_PLACEMENT_USE_FP_BBOX=0
# OPENHAC_PLACEMENT_GRID_MM=7.0
# OPENHAC_PLACEMENT_GRID_COLS=6
# Z3 module-level spacing (CLI: ``--module-gap-mm``). Helps when packed footprints overlap across module regions.
# After heuristic bbox, refine module width/height using pcbnew footprint sizes + same row-pack as placement (default on).
# OPENHAC_MODULE_BBOX_FROM_FP_PACK=0
# Run de-overlap post-process multiple times (1–20; default 1). Separates collisions; does not pack denser.
# OPENHAC_DEOVERLAP_PASSES=2
# Schematic: wider grid reduces overlapping symbols (KiCad units).
# OPENHAC_SCHEMATIC_COLS_PER_ROW=8
# OPENHAC_SCHEMATIC_CELL_SPACING=16
# Embed symbol defs into .kicad_sch so Eeschema shows graphics without sym-lib-table (default on).
# OPENHAC_SCHEMATIC_EMBED_SYMBOLS=0
# Footprint↔footprint bbox gate in fabrication (or set OPENHAC_PCB_CHECK_FP_OVERLAP=1).
# OPENHAC_PCB_CHECK_FP_OVERLAP=0
# OPENHAC_FP_OVERLAP_CLEARANCE_MM=0.5
# Fail compile when netted pins do not match footprint pads (PCB-002); same as `openhac compile --strict-footprint-pads`.
# OPENHAC_STRICT_FOOTPRINT_PIN_PAD=1
# Refuse invented Pin_N pinouts even in handoff (FAB-001 loud warning is always on).
# OPENHAC_STRICT_PINOUT=1
