# Copy to `.env` in the repo root (gitignored). Loaded automatically by `openhac` CLI.
# See `openhac database vendor_apis` docstring in `openhac/database/vendor_apis.py` for API registration.

# --- Autorouting (FreeRouting JAR) ---
# FREEROUTING_JAR=/path/to/freerouting-2.x.jar
# Optional wall-clock cap on the Java process (unset = no limit; large boards can take a long time).
# OPENHAC_FREEROUTING_TIMEOUT_S=3600

# --- Part enrichment (at least one set for online pinout / vendor metadata) ---
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# Use sandbox app credentials against Digi-Key sandbox host (401 often = prod/sandbox mismatch):
# DIGIKEY_USE_SANDBOX=1
# Or set full base URL: DIGIKEY_API_BASE=https://sandbox-api.digikey.com
# MOUSER_API_KEY=
# TME: portal "Token" → TME_API_TOKEN; "Application secret" → TME_API_SECRET (not customer number).
# If you get HTTP 403, check the developer portal: declared "purpose" must match API use (e.g. catalog vs order-only).
# TME_API_TOKEN=
# TME_API_SECRET=
# JLC: LCSC SKU lookup uses POST jlcpcb.com/.../selectSmtComponentList/v2 (no key) first; optional legacy GET + jlcsearch.
# Partner portal docs live at https://api.jlcpcb.com/ (App ID + Access Key) — different stack, not used here yet.
# JLCPCB_SMT_SEARCH_URL=
# JLCPCB_DISABLE_SMT=1
# JLCPCB_DISABLE_JLCSEARCH=1
# JLCPCB_API_KEY=

# --- Optional overrides ---
# OPENHAC_DB_PATH=/path/to/custom.db

# --- Placement / PCB fit (compiler) ---
# Initial SKiDL grid uses footprint bbox sizes when pcbnew can load libs (default on).
# OPENHAC_PLACEMENT_USE_FP_BBOX=0
# OPENHAC_PLACEMENT_FP_GAP_MM=1.0
# OPENHAC_PLACEMENT_GRID_MM=7.0
# OPENHAC_PLACEMENT_GRID_COLS=6
# Footprint↔footprint bbox gate in fabrication (or set OPENHAC_PCB_CHECK_FP_OVERLAP=1).
# OPENHAC_PCB_CHECK_FP_OVERLAP=0
# OPENHAC_FP_OVERLAP_CLEARANCE_MM=0.5
